<launch>
  <!-- Livox MID-360を使用してシミュレータなしで実行するlaunchファイル -->
  
  <!-- size of map, change the size inflate x, y, z according to your application -->
  <arg name="map_size_x" value="80.0"/>
  <arg name="map_size_y" value="80.0"/>
  <arg name="map_size_z" value="6.0"/>

  <!-- topic of your odometry such as VIO or LIO -->
  <arg name="odom_topic" value="/Odometry" />

  <!-- main algorithm params optimized for Livox -->
  <include file="$(find ego_planner)/launch/livox_only_param.xml">

    <arg name="map_size_x_" value="$(arg map_size_x)"/>
    <arg name="map_size_y_" value="$(arg map_size_y)"/>
    <arg name="map_size_z_" value="$(arg map_size_z)"/>
    <arg name="odometry_topic" value="$(arg odom_topic)"/>

    <!-- topic of point cloud measurement from Livox LiDAR -->
    <arg name="cloud_topic" value="/livox/points"/>

    <!-- intrinsic params - Livoxでは使用しないが、パラメータとして必要 -->
    <arg name="cx" value="320.0"/>
    <arg name="cy" value="240.0"/>
    <arg name="fx" value="400.0"/>
    <arg name="fy" value="400.0"/>

    <!-- maximum velocity and acceleration the drone will reach -->
    <arg name="max_vel" value="3.0" />
    <arg name="max_acc" value="4.0" />

    <!-- LiDARの長いレンジに合わせてプランニング範囲を拡大 -->
    <arg name="planning_horizon" value="15.0" /> 

    <!-- 1: use 2D Nav Goal to select goal  -->
    <!-- 2: use global waypoints below  -->
    <arg name="flight_type" value="1" />
    
    <!-- global waypoints -->
    <!-- It generates a piecewise min-snap traj passing all waypoints -->
    <arg name="point_num" value="5" />

    <arg name="point0_x" value="-20.0" />
    <arg name="point0_y" value="0.0" />
    <arg name="point0_z" value="2.0" />

    <arg name="point1_x" value="0.0" />
    <arg name="point1_y" value="20.0" />
    <arg name="point1_z" value="2.0" />

    <arg name="point2_x" value="20.0" />
    <arg name="point2_y" value="0.0" />
    <arg name="point2_z" value="2.0" />

    <arg name="point3_x" value="0.0" />
    <arg name="point3_y" value="-20.0" />
    <arg name="point3_z" value="2.0" />

    <arg name="point4_x" value="-20.0" />
    <arg name="point4_y" value="0.0" />
    <arg name="point4_z" value="2.0" />
    
  </include>

  <!-- trajectory server -->
  <node pkg="ego_planner" name="traj_server" type="traj_server" output="screen">
    <remap from="/position_cmd" to="planning/pos_cmd"/>
    <remap from="/odom_world" to="$(arg odom_topic)"/>
    <param name="traj_server/time_forward" value="1.0" type="double"/>
  </node>

  <!-- waypoint generator -->
  <node pkg="waypoint_generator" name="waypoint_generator" type="waypoint_generator" output="screen">
    <remap from="~odom" to="$(arg odom_topic)"/>        
    <remap from="~goal" to="/move_base_simple/goal"/>
    <remap from="~traj_start_trigger" to="/traj_start_trigger" />
    <param name="waypoint_type" value="manual-lonely-waypoint"/>    
  </node>

  <!-- RViz for visualization -->
  <include file="$(find ego_planner)/launch/rviz.launch"/>

  <!-- Frame transformation from livox_frame to world (if needed) -->
  <node pkg="tf" type="static_transform_publisher" name="livox_to_world_transform"
        args="0 0 0 0 0 0 world livox_frame 100"/>

</launch>