<launch>
  <!-- Debug version - minimal setup for testing -->
  
  <!-- Map parameters -->
  <arg name="map_size_x" value="40.0"/>
  <arg name="map_size_y" value="40.0"/>
  <arg name="map_size_z" value="4.0"/>
  <arg name="odom_topic" value="/Odometry"/>

  <!-- Essential TF setup -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="world_origin"
        args="0 0 0 0 0 0 world camera_init"/>
  
  <node pkg="tf2_ros" type="static_transform_publisher" name="sensor_mount"
        args="0 0 0.1 0 0 0 body livox_frame"/>

  <!-- Simple EGO Planner setup -->
  <node pkg="ego_planner" name="ego_planner_node" type="ego_planner_node" output="screen">
    <remap from="/odom_world" to="$(arg odom_topic)"/>
    <remap from="/grid_map/odom" to="$(arg odom_topic)"/>
    <remap from="/grid_map/cloud" to="/livox/points"/>

    <!-- Basic planning -->
    <param name="fsm/flight_type" value="1" type="int"/>
    <param name="fsm/planning_horizon" value="8.0" type="double"/>
    <param name="fsm/waypoint_num" value="1" type="int"/>
    <param name="fsm/waypoint0_x" value="3.0" type="double"/>
    <param name="fsm/waypoint0_y" value="0.0" type="double"/>
    <param name="fsm/waypoint0_z" value="1.0" type="double"/>

    <!-- Conservative grid map -->
    <param name="grid_map/resolution" value="0.2"/>
    <param name="grid_map/map_size_x" value="$(arg map_size_x)"/>
    <param name="grid_map/map_size_y" value="$(arg map_size_y)"/>
    <param name="grid_map/map_size_z" value="$(arg map_size_z)"/>
    <param name="grid_map/local_update_range_x" value="6.0"/>
    <param name="grid_map/local_update_range_y" value="6.0"/>
    <param name="grid_map/local_update_range_z" value="3.0"/>
    <param name="grid_map/obstacles_inflation" value="0.05"/>
    <param name="grid_map/ground_height" value="-0.5"/>

    <!-- Relaxed occupancy -->
    <param name="grid_map/p_hit" value="0.55"/>
    <param name="grid_map/p_miss" value="0.45"/>
    <param name="grid_map/p_occ" value="0.70"/>
    <param name="grid_map/max_ray_length" value="50.0"/>
    
    <!-- Use livox_frame instead of world to test -->
    <param name="grid_map/frame_id" value="livox_frame"/>

    <!-- Dummy camera params -->
    <param name="grid_map/cx" value="320.0"/>
    <param name="grid_map/cy" value="240.0"/>
    <param name="grid_map/fx" value="400.0"/>
    <param name="grid_map/fy" value="400.0"/>
    <param name="grid_map/use_depth_filter" value="false"/>

    <!-- Conservative motion -->
    <param name="manager/max_vel" value="1.0" type="double"/>
    <param name="manager/max_acc" value="1.5" type="double"/>
    <param name="manager/planning_horizon" value="8.0" type="double"/>

    <param name="optimization/dist0" value="0.3" type="double"/>
    <param name="bspline/limit_vel" value="1.0" type="double"/>
    <param name="bspline/limit_acc" value="1.5" type="double"/>
  </node>

  <!-- Essential support nodes -->
  <node pkg="ego_planner" name="traj_server" type="traj_server" output="screen">
    <remap from="/position_cmd" to="planning/pos_cmd"/>
    <remap from="/odom_world" to="$(arg odom_topic)"/>
    <param name="traj_server/time_forward" value="1.0" type="double"/>
  </node>

  <node pkg="waypoint_generator" name="waypoint_generator" type="waypoint_generator" output="screen">
    <remap from="~odom" to="$(arg odom_topic)"/>
    <remap from="~goal" to="/move_base_simple/goal"/>
    <remap from="~traj_start_trigger" to="/traj_start_trigger"/>
    <param name="waypoint_type" value="manual-lonely-waypoint"/>
  </node>

    <!-- RViz for visualization -->
  <include file="$(find ego_planner)/launch/rviz.launch"/>

</launch>